---
layout: base.njk
---
<article class="note">
  <p class="breadcrumb"><a href="/">Beranda</a> / <a href="/kategori/{{ category | slugify }}/">{{ category }}</a></p>
  <h1>{{ title }}</h1>
  <p class="meta">{{ category }} &middot; {{ date | readableDate }}</p>
  <div class="content">
    {{ content | safe }}
  </div>
</article>
