# Salin file ini jadi .env.local lalu isi dengan nilai dari dashboard
# Supabase project kamu (Project Settings -> API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Hanya untuk script seed (scripts/seed.mjs), JANGAN pernah dipakai di
# kode sisi client/browser. Ambil dari Project Settings -> API Keys ->
# secret key (atau service_role key kalau project masih pakai skema lama).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Opsional -- isi untuk mengaktifkan fitur "Tanya AI" (app/actions/ask-ai.ts).
# Endpoint apa pun yang kompatibel dengan format OpenAI Chat Completions
# API (POST {AI_BASE_URL}/chat/completions) -- OpenAI asli, Groq,
# OpenRouter, Ollama lokal (mis. http://localhost:11434/v1), dll. Hanya
# dipakai di server (Server Action), tidak pernah dikirim ke browser.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o-mini
